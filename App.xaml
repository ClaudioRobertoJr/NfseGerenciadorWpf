<Application x:Class="NfseGerenciador.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:NfseGerenciador.Converters"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:BooleanToStatusTextConverter x:Key="BooleanToStatusTextConverter"/>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:ColorBrightnessConverter x:Key="ColorBrightnessConverter"/>
            <converters:InvertedBooleanConverter x:Key="InvertedBooleanConverter"/>

            <SolidColorBrush x:Key="CorPrimariaAplicacaoBrush" Color="#2563EB"/>
            <SolidColorBrush x:Key="CorPrimariaTextoAplicacaoBrush" Color="White"/>
            <SolidColorBrush x:Key="CorSecundariaAplicacaoBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CorSecundariaTextoAplicacaoBrush" Color="#FF333333"/>
            <SolidColorBrush x:Key="CorBordaSecundariaBrush" Color="#CBD5E1"/>
            <SolidColorBrush x:Key="CorStatusPagaBrush" Color="DarkGreen"/>
            <SolidColorBrush x:Key="CorStatusPendenteBrush" Color="#D32F2F"/>
            <SolidColorBrush x:Key="CorFontePadraoBrush" Color="#0F172A"/>
            <SolidColorBrush x:Key="CorBordaPainelBrush" Color="#E2E8F0"/>
            <SolidColorBrush x:Key="CorFundoJanelaBrush" Color="#F3F6FB"/>
            <SolidColorBrush x:Key="CorFundoPainelBrush" Color="White"/>
            <FontFamily x:Key="FontePrincipalAplicacao">Segoe UI</FontFamily>
            <FontFamily x:Key="FonteTitulosAplicacao">Segoe UI Semibold</FontFamily>
            <sys:Double x:Key="FontSizePequeno">12</sys:Double>
            <sys:Double x:Key="FontSizeMedio">13</sys:Double>
            <sys:Double x:Key="FontSizeGrande">15</sys:Double>
            <sys:Double x:Key="FontSizeTituloSecao">16</sys:Double>
            <sys:Double x:Key="FontSizeTituloJanela">18</sys:Double>
            <sys:String x:Key="IconeNotaFiscal">&#xE729;</sys:String>
            <sys:String x:Key="IconeEmpresa">&#xE716;</sys:String>
            <sys:String x:Key="IconeRelatorio">&#xE749;</sys:String>
            <sys:String x:Key="IconeDashboard">&#xE756;</sys:String>
            <sys:String x:Key="IconeBackup">&#xE7A3;</sys:String>
            <sys:String x:Key="IconeConfiguracoes">&#xE713;</sys:String>
            <sys:String x:Key="IconeSair">&#xE7E8;</sys:String>

            <Style TargetType="{x:Type Control}">
                <Setter Property="FontFamily" Value="{StaticResource FontePrincipalAplicacao}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeMedio}"/>
                <Setter Property="Foreground" Value="{StaticResource CorFontePadraoBrush}"/>
            </Style>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{StaticResource FontePrincipalAplicacao}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeMedio}"/>
            </Style>
            <Style TargetType="{x:Type Window}">
                <Setter Property="Background" Value="{StaticResource CorFundoJanelaBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource CorFontePadraoBrush}"/>
            </Style>
            <Style TargetType="{x:Type CheckBox}">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,5,10,5"/>
            </Style>

            <Style x:Key="PainelAgrupamentoStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource CorBordaPainelBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="15"/>
                <Setter Property="Margin" Value="0,0,0,15"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Background" Value="{StaticResource CorFundoPainelBrush}"/>
            </Style>
            <Style x:Key="TituloSecaoStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource FontSizeTituloSecao}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontFamily" Value="{StaticResource FonteTitulosAplicacao}"/>
                <Setter Property="Foreground" Value="{StaticResource CorPrimariaAplicacaoBrush}"/>
                <Setter Property="Margin" Value="0,0,0,15"/>
            </Style>
            <Style x:Key="BotaoBaseStyle" TargetType="Button">
                <Setter Property="Padding" Value="14,9"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="MinWidth" Value="90"/>
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{Binding Path=Background, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ColorBrightnessConverter}, ConverterParameter=0.9}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{Binding Path=Background, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ColorBrightnessConverter}, ConverterParameter=0.7}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Background" Value="#FFCCCCCC"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#FFBBBBBB"/>
                                    <Setter Property="Foreground" Value="#FF888888"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ControleFiltroFormularioStyle" TargetType="Control" BasedOn="{StaticResource {x:Type Control}}">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,5,10,5"/>
                <Setter Property="MinHeight" Value="34"/>
            </Style>
            <Style TargetType="DatePicker" BasedOn="{StaticResource ControleFiltroFormularioStyle}"/>
            <Style TargetType="ComboBox" BasedOn="{StaticResource ControleFiltroFormularioStyle}"/>
            <Style TargetType="TextBox" BasedOn="{StaticResource ControleFiltroFormularioStyle}"/>
            <Style TargetType="{x:Type Label}" BasedOn="{StaticResource {x:Type Control}}">
                <Setter Property="Padding" Value="0"/>
            </Style>

            <Style x:Key="LabelFiltroFormularioStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="10,0,5,0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="IconeEmBotaoStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                <Setter Property="FontSize" Value="{Binding Path=FontSize, RelativeSource={RelativeSource AncestorType=Button}}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Foreground" Value="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Style>

            <Style x:Key="BotaoPrimarioStyle" TargetType="Button" BasedOn="{StaticResource BotaoBaseStyle}">
                <Setter Property="Background" Value="{StaticResource CorPrimariaAplicacaoBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource CorPrimariaTextoAplicacaoBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource CorPrimariaAplicacaoBrush}"/>
            </Style>
            <Style x:Key="BotaoSecundarioStyle" TargetType="Button" BasedOn="{StaticResource BotaoBaseStyle}">
                <Setter Property="Background" Value="{StaticResource CorSecundariaAplicacaoBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource CorSecundariaTextoAplicacaoBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource CorBordaSecundariaBrush}"/>
            </Style>
            <Style x:Key="BotaoMenuPrincipalStyle" TargetType="Button" BasedOn="{StaticResource BotaoPrimarioStyle}">
                <Setter Property="Width" Value="320"/>
                <Setter Property="Height" Value="55"/>
                <Setter Property="Margin" Value="15"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeGrande}"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="20,0"/>
            </Style>

            <Style x:Key="KpiCardStyle" TargetType="Border" BasedOn="{StaticResource PainelAgrupamentoStyle}">
                <Setter Property="Padding" Value="15"/>
                <Setter Property="Margin" Value="8"/>
            </Style>
            <Style x:Key="KpiTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize" Value="{StaticResource FontSizeMedio}"/>
                <Setter Property="Foreground" Value="Gray"/>
                <Setter Property="Margin" Value="0,0,0,5"/>
            </Style>
            <Style x:Key="KpiValueStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize" Value="26"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontFamily" Value="{StaticResource FonteTitulosAplicacao}"/>
                <Setter Property="Foreground" Value="{StaticResource CorPrimariaAplicacaoBrush}"/>
            </Style>
            <Style x:Key="ChartCardStyle" TargetType="Border" BasedOn="{StaticResource PainelAgrupamentoStyle}">
                <Setter Property="Padding" Value="20"/>
                <Setter Property="Margin" Value="8"/>
            </Style>
            <Style x:Key="ChartTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TituloSecaoStyle}">
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeGrande}"/>
                <Setter Property="Margin" Value="0,0,0,15"/>
            </Style>
            <Style x:Key="CabecalhoJanelaStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CorPrimariaAplicacaoBrush}"/>
                <Setter Property="Padding" Value="15"/>
            </Style>

            <Style x:Key="TextoCabecalhoJanelaStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource CorPrimariaTextoAplicacaoBrush}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeTituloJanela}"/>
                <Setter Property="FontFamily" Value="{StaticResource FonteTitulosAplicacao}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="StatusBarStyle" TargetType="StatusBar">
                <Setter Property="Background" Value="{StaticResource CorSecundariaAplicacaoBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource CorSecundariaTextoAplicacaoBrush}"/>
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource BotaoSecundarioStyle}"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
