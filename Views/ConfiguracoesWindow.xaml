<Window x:Class="NfseGerenciador.Views.ConfiguracoesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:NfseGerenciador.Converters"
        mc:Ignorable="d"
        Title="Configurações" Height="450" Width="700"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid>
        <Grid IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBooleanConverter}}">
            <StackPanel Margin="20">
                <TextBlock Text="Configurações do Sistema" FontSize="22" FontWeight="Bold" Margin="0,0,0,20" />

                <GroupBox Header="Configuração do Banco de Dados" Padding="10">
                    <StackPanel>
                        <TextBlock Text="String de Conexão:" Margin="0,0,0,5" />
                        <TextBox Text="{Binding ConnectionString, UpdateSourceTrigger=PropertyChanged}" Height="80" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
                        <Button Command="{Binding TestarConexaoCommand}" Content="Testar Conexão" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="10,5"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Configuração de Backup" Padding="10" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="Pasta Padrão para Backups:" Margin="0,0,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding BackupPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Command="{Binding ProcurarPastaBackupCommand}" Content="..." Padding="10,5" Margin="5,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <Button Command="{Binding SalvarCommand}" Content="Salvar Configurações" HorizontalAlignment="Right" Margin="0,25,0,0" Padding="15,8" FontWeight="Bold"/>

                <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Center" Margin="0,15,0,0" FontStyle="Italic"/>
            </StackPanel>
        </Grid>

        <Border Background="#80000000" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                <ProgressBar IsIndeterminate="True" Width="300" Height="25" Margin="0,15,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>