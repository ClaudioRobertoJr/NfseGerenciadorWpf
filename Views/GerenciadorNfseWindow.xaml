<Window x:Class="NfseGerenciador.Views.GerenciadorNfseWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Notas e recebimentos • NFSe" Width="1320" Height="820" MinWidth="980" MinHeight="580" WindowState="Maximized" WindowStartupLocation="CenterOwner" Language="pt-BR">
 <Window.Resources><Style x:Key="ValorDireita" TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style></Window.Resources>
 <Grid Margin="24,20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18">
   <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" IsEnabled="{Binding IsBusy,Converter={StaticResource InvertedBooleanConverter}}">
    <Button Content="Importar XML" Command="{Binding ImportarXmlCommand}" Style="{StaticResource BotaoSecundarioStyle}"/>
    <Button Content="Importar baixas" Click="ImportarBaixas" Style="{StaticResource BotaoPrimarioStyle}"/>
    <Button Content="Atualizar" Command="{Binding AtualizarListaCommand}" Style="{StaticResource BotaoSecundarioStyle}"/>
   </WrapPanel>
   <StackPanel><TextBlock Text="Notas e recebimentos" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Consulte notas e registre recebimentos." Foreground="#64748B" Margin="0,5,0,0"/></StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Style="{StaticResource PainelAgrupamentoStyle}" Padding="16,10">
   <WrapPanel IsEnabled="{Binding IsBusy,Converter={StaticResource InvertedBooleanConverter}}">
    <StackPanel Width="140"><TextBlock Text="Situação" Foreground="#64748B"/><ComboBox ItemsSource="{Binding OpcoesStatusFiltro}" SelectedItem="{Binding FiltroStatus}"/></StackPanel>
    <StackPanel Width="145"><TextBlock Text="Local de pagamento" Foreground="#64748B"/><ComboBox ItemsSource="{Binding OpcoesLocalFiltro}" SelectedItem="{Binding FiltroLocal}"/></StackPanel>
    <StackPanel Width="145"><TextBlock Text="{Binding RotuloDataInicial}" Foreground="#64748B"/><DatePicker SelectedDate="{Binding FiltroDataInicial}"/></StackPanel>
    <StackPanel Width="145"><TextBlock Text="Até" Foreground="#64748B"/><DatePicker SelectedDate="{Binding FiltroDataFinal}"/></StackPanel>
    <StackPanel Width="250"><TextBlock Text="Tomador, CPF/CNPJ ou nota" Foreground="#64748B"/><TextBox Text="{Binding FiltroTexto,UpdateSourceTrigger=PropertyChanged,Delay=350}" VerticalContentAlignment="Center"/></StackPanel>
    <Button Content="Limpar filtros" Command="{Binding LimparFiltrosCommand}" Style="{StaticResource BotaoSecundarioStyle}" VerticalAlignment="Bottom"/>
   </WrapPanel>
  </Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,10"><TextBlock DockPanel.Dock="Right" Text="{Binding TotalFiltrado,StringFormat=C2}" FontWeight="Bold" FontSize="18"/>
     <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding TotalItems,StringFormat={}{0} notas}" FontWeight="SemiBold"/><TextBlock Text="{Binding PendentesFiltradas,StringFormat={}  •  {0} pendentes}" Foreground="#64748B"/></StackPanel>
    </DockPanel>
    <DataGrid Grid.Row="1" ItemsSource="{Binding Nfses}" SelectedItem="{Binding NfseSelecionada}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" IsEnabled="{Binding IsBusy,Converter={StaticResource InvertedBooleanConverter}}">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Nota" Binding="{Binding Numero}" Width="70"/>
      <DataGridTextColumn Header="Emissão" Binding="{Binding DataEmissao,StringFormat=dd/MM/yyyy}" Width="95"/>
      <DataGridTextColumn Header="Valor" Binding="{Binding ValorLiquidoNfse,StringFormat=C2}" Width="110" ElementStyle="{StaticResource ValorDireita}"/>
      <DataGridTextColumn Header="Tomador" Binding="{Binding TomadorRazaoSocial}" Width="*" MinWidth="170"/>
      <DataGridTemplateColumn Header="Situação" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate>
       <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Left"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#FFF4DE"/><Style.Triggers><DataTrigger Binding="{Binding EstaPago}" Value="True"><Setter Property="Background" Value="#DCFCE7"/></DataTrigger></Style.Triggers></Style></Border.Style>
        <TextBlock Text="{Binding EstaPago,Converter={StaticResource BooleanToStatusTextConverter}}" FontSize="12" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#92400E"/><Style.Triggers><DataTrigger Binding="{Binding EstaPago}" Value="True"><Setter Property="Foreground" Value="#166534"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       </Border>
      </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="Local" Binding="{Binding Local}" Width="100"/>
      <DataGridTextColumn Header="Recebimento" Binding="{Binding DataPagamentoEfetivo,StringFormat=dd/MM/yyyy}" Width="105"/>
      <DataGridTextColumn Header="Forma" Binding="{Binding Pagamento.TipoRecebimento}" Width="110"/>
     </DataGrid.Columns>
    </DataGrid>
   </Grid>
   <Border Grid.Column="2" Style="{StaticResource PainelAgrupamentoStyle}" Margin="0" Padding="18">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding IsBusy,Converter={StaticResource InvertedBooleanConverter}}"><StackPanel>
     <TextBlock Text="Pagamento da nota" FontSize="18" FontWeight="SemiBold"/>
     <TextBlock Text="Selecione uma nota na tabela para consultar ou editar." TextWrapping="Wrap" Foreground="#64748B" Margin="0,6,0,14"/>
     <StackPanel IsEnabled="{Binding IsDetalhesVisible}">
      <TextBlock Text="{Binding NfseSelecionada.Numero,StringFormat=Nota {0}}" FontSize="24" FontWeight="SemiBold" Foreground="#2563EB"/>
      <TextBlock Text="{Binding NfseSelecionada.TomadorRazaoSocial}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,5,0,6"/>
      <TextBlock Text="{Binding NfseSelecionada.ValorLiquidoNfse,StringFormat=C2}" FontSize="20" Margin="0,0,0,14"/>
      <CheckBox Content="Nota paga" IsChecked="{Binding DetalhesEstaPago}" FontWeight="SemiBold"/>
      <TextBlock Text="Local de pagamento" Margin="0,10,0,0" Foreground="#64748B"/><ComboBox ItemsSource="{Binding LocaisPagamento}" SelectedItem="{Binding DetalhesLocalPagamento}"/>
      <TextBlock Text="Data do recebimento" Margin="0,8,0,0" Foreground="#64748B"/><DatePicker SelectedDate="{Binding DetalhesDataPagamento}" IsEnabled="{Binding DetalhesEstaPago}"/>
      <TextBlock Text="Forma de pagamento" Margin="0,8,0,0" Foreground="#64748B"/><ComboBox ItemsSource="{Binding TiposPagamento}" SelectedItem="{Binding DetalhesTipoRecebimento}" DisplayMemberPath="TipoRecebimento" IsEnabled="{Binding DetalhesEstaPago}"/>
      <DockPanel Margin="0,8"><CheckBox DockPanel.Dock="Left" Content="À vista" IsChecked="{Binding DetalhesEhAVista}" IsEnabled="{Binding DetalhesEstaPago}"/><TextBox Text="{Binding DetalhesNumParcelas,UpdateSourceTrigger=PropertyChanged}" Width="65" HorizontalAlignment="Right" ToolTip="Número de parcelas" IsEnabled="{Binding DetalhesEhAVista,Converter={StaticResource InvertedBooleanConverter}}"/><TextBlock Text="Parcelas" VerticalAlignment="Center" HorizontalAlignment="Right"/></DockPanel>
      <Button Content="Salvar pagamento" Command="{Binding SalvarPagamentoCommand}" Style="{StaticResource BotaoPrimarioStyle}" Margin="0,6,0,12"/>
      <Expander Header="Parcelas da nota" Margin="0,6"><DataGrid ItemsSource="{Binding NfseSelecionada.Parcelas}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MaxHeight="180" Margin="0,8,0,0"><DataGrid.Columns>
       <DataGridTextColumn Header="Nº" Binding="{Binding NumeroParcela}" Width="40"/><DataGridTextColumn Header="Valor" Binding="{Binding ValorParcela,StringFormat=C2}" Width="90"/><DataGridTextColumn Header="Vencimento" Binding="{Binding DataVencimentoParcela,StringFormat=dd/MM/yyyy}" Width="100"/><DataGridTextColumn Header="Pagamento" Binding="{Binding DataPagamentoParcela,StringFormat=dd/MM/yyyy}" Width="100"/>
      </DataGrid.Columns></DataGrid></Expander>
      <Button Content="Excluir nota" Command="{Binding ExcluirNotaCommand}" Style="{StaticResource BotaoSecundarioStyle}" Foreground="#B91C1C" Margin="0,16,0,0"/>
     </StackPanel>
    </StackPanel></ScrollViewer>
   </Border>
   <Border Grid.ColumnSpan="3" Background="#CCF3F6FB" Visibility="{Binding IsBusy,Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="Atualizando informações…" FontSize="17" FontWeight="SemiBold"/><ProgressBar IsIndeterminate="True" Height="4" Width="220" Margin="0,14"/></StackPanel></Border>
  </Grid>
  <DockPanel Grid.Row="3" Margin="0,12,0,0"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Anterior" Command="{Binding PaginaAnteriorCommand}" Style="{StaticResource BotaoSecundarioStyle}"/><Button Content="Próxima" Command="{Binding ProximaPaginaCommand}" Style="{StaticResource BotaoSecundarioStyle}"/></StackPanel><TextBlock Text="{Binding StatusPaginacao}" VerticalAlignment="Center" Foreground="#64748B"/></DockPanel>
 </Grid>
</Window>
