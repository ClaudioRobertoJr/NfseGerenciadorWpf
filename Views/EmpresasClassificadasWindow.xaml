<Window x:Class="NfseGerenciador.Views.EmpresasClassificadasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NfseGerenciador.Views"
        mc:Ignorable="d"
        Title="Gerenciar Empresas Classificadas" Height="550" Width="800"
        WindowStartupLocation="CenterScreen">

    <Grid IsEnabled="{Binding IsViewEnabled}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CabecalhoJanelaStyle}">
            <TextBlock Text="Gerenciar Empresas Classificadas" Style="{StaticResource TextoCabecalhoJanelaStyle}"/>
        </Border>

        <DockPanel Grid.Row="1" Margin="15">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Command="{Binding NovoCommand}" Style="{StaticResource BotaoSecundarioStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource IconeEmBotaoStyle}"/>
                        <TextBlock Text="Novo/Limpar" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SalvarCommand}" Style="{StaticResource BotaoPrimarioStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" Style="{StaticResource IconeEmBotaoStyle}"/>
                        <TextBlock Text="Salvar" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ExcluirCommand}" Style="{StaticResource BotaoSecundarioStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource IconeEmBotaoStyle}" Foreground="{StaticResource CorStatusPendenteBrush}"/>
                        <TextBlock Text="Excluir" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <Border DockPanel.Dock="Top" Style="{StaticResource PainelAgrupamentoStyle}" Margin="0,0,0,15">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Dados da Empresa" Style="{StaticResource TituloSecaoStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Razão Social:" Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelFiltroFormularioStyle}"/>
                        <TextBox Text="{Binding RazaoSocial, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Style="{StaticResource ControleFiltroFormularioStyle}"/>

                        <TextBlock Text="CNPJ:" Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelFiltroFormularioStyle}"/>
                        <TextBox Text="{Binding Cnpj, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" MaxLength="18" Style="{StaticResource ControleFiltroFormularioStyle}"/>

                        <TextBlock Text="Tipo de Classificação:" Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelFiltroFormularioStyle}"/>
                        <ComboBox ItemsSource="{Binding TiposClassificacaoDisponiveis}" 
                                  SelectedItem="{Binding TipoClassificacao}" 
                                  Grid.Row="2" Grid.Column="1" Style="{StaticResource ControleFiltroFormularioStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <DataGrid ItemsSource="{Binding Empresas}" 
                      SelectedItem="{Binding EmpresaSelecionada, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Single" 
                      AlternatingRowBackground="#FFF9F9F9">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto" MinWidth="50" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Razão Social" Binding="{Binding RazaoSocial}" Width="2*"/>
                    <DataGridTextColumn Header="CNPJ" Binding="{Binding Cnpj}" Width="*" MinWidth="150"/>
                    <DataGridTextColumn Header="Tipo Classificação" Binding="{Binding TipoClassificacao}" Width="*" MinWidth="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Border Grid.RowSpan="2" Background="#80FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Processando..." FontSize="18" FontWeight="SemiBold" Margin="10"/>
                <ProgressBar IsIndeterminate="True" Width="200" Height="20"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>