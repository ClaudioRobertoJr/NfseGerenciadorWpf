<Window x:Class="NfseGerenciador.JanelaPrincipal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="NFSe • Gestão de recebimentos" Width="1040" Height="720" MinWidth="800" MinHeight="560" WindowStartupLocation="CenterScreen" Language="pt-BR">
 <Window.Resources><Style x:Key="AcaoMenu" TargetType="Button" BasedOn="{StaticResource BotaoSecundarioStyle}"><Setter Property="Width" Value="280"/><Setter Property="Height" Value="138"/><Setter Property="Margin" Value="8"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="20"/></Style></Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#142D50" Padding="32,28"><DockPanel><Border DockPanel.Dock="Right" Background="#25476F" CornerRadius="6" Padding="12,6" VerticalAlignment="Top"><TextBlock Text="GESTÃO FINANCEIRA" Foreground="#D5E6FF" FontSize="11" FontWeight="SemiBold"/></Border><StackPanel><TextBlock Text="NFSe" FontSize="34" FontWeight="Bold" Foreground="White"/><TextBlock Text="Notas organizadas. Recebimentos sob controle." Foreground="#CBDCF0" FontSize="16" Margin="0,6,0,0"/></StackPanel></DockPanel></Border>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24"><StackPanel><TextBlock Text="O que você precisa fazer?" FontSize="21" FontWeight="SemiBold" Margin="8,0,0,14"/>
   <WrapPanel HorizontalAlignment="Center"><Button Click="BtnGerenciarNotas_Click" Style="{StaticResource AcaoMenu}" Background="#2563EB" BorderBrush="#2563EB"><StackPanel><TextBlock Text="Notas e recebimentos" FontSize="19" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="Importe XML, confira pendências&#10;e faça baixas pelo relatório." Foreground="#DBEAFE" Margin="0,10,0,0"/></StackPanel></Button>
<Button Click="BtnDashboard_Click" Style="{StaticResource AcaoMenu}" ><StackPanel><TextBlock Text="Visão geral" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="Acompanhe valores e indicadores&#10;dos recebimentos." Foreground="#64748B" Margin="0,10,0,0"/></StackPanel></Button>
<Button Click="BtnRelatorios_Click" Style="{StaticResource AcaoMenu}" ><StackPanel><TextBlock Text="Relatórios" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="Consulte resultados por período&#10;e local de pagamento." Foreground="#64748B" Margin="0,10,0,0"/></StackPanel></Button>
<Button Click="BtnGerenciarEmpresas_Click" Style="{StaticResource AcaoMenu}" ><StackPanel><TextBlock Text="Empresas" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="Organize cadastros e classificações&#10;dos tomadores." Foreground="#64748B" Margin="0,10,0,0"/></StackPanel></Button>
<Button Click="BtnBackup_Click" Style="{StaticResource AcaoMenu}" ><StackPanel><TextBlock Text="Backup e restauração" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="Crie cópias de segurança&#10;e acesse a recuperação." Foreground="#64748B" Margin="0,10,0,0"/></StackPanel></Button>
<Button Click="BtnConfiguracoes_Click" Style="{StaticResource AcaoMenu}" ><StackPanel><TextBlock Text="Configurações" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="Confira a conexão com o banco&#10;e a pasta de backup." Foreground="#64748B" Margin="0,10,0,0"/></StackPanel></Button></WrapPanel>
  </StackPanel></ScrollViewer>
  <DockPanel Grid.Row="2" Margin="32,10,32,20"><Button DockPanel.Dock="Right" Content="Sair" Click="BtnSair_Click" Style="{StaticResource BotaoSecundarioStyle}"/><TextBlock Text="Gerenciador de Notas Fiscais Eletrônicas" Foreground="#64748B" VerticalAlignment="Center"/></DockPanel>
 </Grid>
</Window>
