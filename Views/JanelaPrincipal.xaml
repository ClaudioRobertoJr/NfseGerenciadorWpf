<Window x:Class="NfseGerenciador.JanelaPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NfseGerenciador"
        mc:Ignorable="d"
        Title="Sistema Gerenciador de NFS-e" Height="500" Width="700"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="BotaoMenuGridStyle" TargetType="Button" BasedOn="{StaticResource BotaoSecundarioStyle}">
            <Setter Property="Width" Value="180"/>
            <Setter Property="Height" Value="100"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource CorBordaPainelBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CabecalhoJanelaStyle}">
            <TextBlock Text="Gerenciador de Notas Fiscais Eletrônicas" Style="{StaticResource TextoCabecalhoJanelaStyle}"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                <Button x:Name="btnGerenciarNotas" Click="BtnGerenciarNotas_Click" Style="{StaticResource BotaoMenuGridStyle}">
                    <StackPanel>
                        <TextBlock Text="{StaticResource IconeNotaFiscal}" FontSize="28" HorizontalAlignment="Center" Style="{StaticResource IconeEmBotaoStyle}" Margin="0,0,0,5"/>
                        <TextBlock Text="Gerenciar Notas" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnGerenciarEmpresas" Click="BtnGerenciarEmpresas_Click" Style="{StaticResource BotaoMenuGridStyle}">
                    <StackPanel>
                        <TextBlock Text="{StaticResource IconeEmpresa}" FontSize="28" HorizontalAlignment="Center" Style="{StaticResource IconeEmBotaoStyle}" Margin="0,0,0,5"/>
                        <TextBlock Text="Gerenciar Empresas" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnRelatorios" Click="BtnRelatorios_Click" Style="{StaticResource BotaoMenuGridStyle}">
                    <StackPanel>
                        <TextBlock Text="{StaticResource IconeRelatorio}" FontSize="28" HorizontalAlignment="Center" Style="{StaticResource IconeEmBotaoStyle}" Margin="0,0,0,5"/>
                        <TextBlock Text="Relatórios" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnDashboard" Click="BtnDashboard_Click" Style="{StaticResource BotaoMenuGridStyle}">
                    <StackPanel>
                        <TextBlock Text="{StaticResource IconeDashboard}" FontSize="28" HorizontalAlignment="Center" Style="{StaticResource IconeEmBotaoStyle}" Margin="0,0,0,5"/>
                        <TextBlock Text="Dashboard" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnBackup" Click="BtnBackup_Click" Style="{StaticResource BotaoMenuGridStyle}">
                    <StackPanel>
                        <TextBlock Text="{StaticResource IconeBackup}" FontSize="28" HorizontalAlignment="Center" Style="{StaticResource IconeEmBotaoStyle}" Margin="0,0,0,5"/>
                        <TextBlock Text="Backup e Restauração" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnConfiguracoes" Click="BtnConfiguracoes_Click" Style="{StaticResource BotaoMenuGridStyle}">
                    <StackPanel>
                        <TextBlock Text="{StaticResource IconeConfiguracoes}" FontSize="28" HorizontalAlignment="Center" Style="{StaticResource IconeEmBotaoStyle}" Margin="0,0,0,5"/>
                        <TextBlock Text="Configurações" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnSair" Click="BtnSair_Click" Style="{StaticResource BotaoMenuGridStyle}" Background="#FFF1F1" BorderBrush="#FFC62828">
                    <StackPanel>
                        <TextBlock Text="{StaticResource IconeSair}" FontSize="28" HorizontalAlignment="Center" Style="{StaticResource IconeEmBotaoStyle}" Margin="0,0,0,5" Foreground="#C62828"/>
                        <TextBlock Text="Sair do Sistema" HorizontalAlignment="Center" Foreground="#C62828"/>
                    </StackPanel>
                </Button>

            </WrapPanel>
        </ScrollViewer>

        <StatusBar Grid.Row="2" Style="{StaticResource StatusBarStyle}">
            <StatusBarItem>
                <TextBlock Text="Bem-vindo ao Sistema Gerenciador de NFS-e!" Margin="5,0"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>