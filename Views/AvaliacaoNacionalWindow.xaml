<Window x:Class="NfseGerenciador.Views.AvaliacaoNacionalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Avaliação do padrão nacional" Width="1000" Height="570" MinWidth="760" MinHeight="400" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="TituloText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="Padrão operacional • Prestador 72.547.623/0001-90" Margin="0,8,0,0"/>
            <TextBlock x:Name="ResumoText" Margin="0,10,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="VersaoText" Margin="0,6,0,16" TextWrapping="Wrap" Foreground="#555555"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="Esta avaliação não corrige a emissão fiscal e não altera pagamentos ou parcelas." TextWrapping="Wrap"/>
            <Button Content="Fechar" IsCancel="True" HorizontalAlignment="Right" Padding="18,7" Margin="0,10,0,0"/>
        </StackPanel>
        <DataGrid x:Name="CamposGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" EnableRowVirtualization="True" AutomationProperties.Name="Campos avaliados do padrão nacional">
            <DataGrid.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="4"/></Style></DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Campo" Binding="{Binding Campo}" Width="1.2*"/>
                <DataGridTextColumn Header="Encontrado (original)" Binding="{Binding ValorExibido}" Width="1.6*"/>
                <DataGridTextColumn Header="Esperado" Binding="{Binding Esperado}" Width="1.6*"/>
                <DataGridTextColumn Header="Resultado" Binding="{Binding ResultadoExibido}" Width="*"/>
                <DataGridTextColumn Header="Motivo" Binding="{Binding Motivo}" Width="1.6*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
