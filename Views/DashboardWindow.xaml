<Window x:Class="NfseGerenciador.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:converters="clr-namespace:NfseGerenciador.Converters"
        mc:Ignorable="d"
        Title="Dashboard Principal" Height="800" Width="1280"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <DockPanel Margin="10" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBooleanConverter}}">

            <Border DockPanel.Dock="Top" Style="{StaticResource CabecalhoJanelaStyle}" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Dashboard de Análise" Style="{StaticResource TextoCabecalhoJanelaStyle}" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="50,0,0,0">
                        <TextBlock Text="Período:" Style="{StaticResource LabelFiltroFormularioStyle}" Foreground="White"/>
                        <ComboBox ItemsSource="{Binding Periodos}" SelectedItem="{Binding PeriodoSelecionado}" Width="180" Style="{StaticResource ControleFiltroFormularioStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,5,0,10">
                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Total Recebido no Período" Style="{StaticResource KpiTitleStyle}"/>
                        <TextBlock Text="{Binding TotalRecebido}" Style="{StaticResource KpiValueStyle}" Foreground="{StaticResource CorStatusPagaBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Total Pendente (Vencido)" Style="{StaticResource KpiTitleStyle}"/>
                        <TextBlock Text="{Binding TotalPendente}" Style="{StaticResource KpiValueStyle}" Foreground="{StaticResource CorStatusPendenteBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Notas Emitidas no Período" Style="{StaticResource KpiTitleStyle}"/>
                        <TextBlock Text="{Binding TotalNotas}" Style="{StaticResource KpiValueStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Ticket Médio (Notas Pagas)" Style="{StaticResource KpiTitleStyle}"/>
                        <TextBlock Text="{Binding TicketMedio}" Style="{StaticResource KpiValueStyle}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource ChartCardStyle}" Grid.Column="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Fluxo de Caixa (Realizado vs. Previsto)" Style="{StaticResource ChartTitleStyle}"/>
                        <lvc:CartesianChart Grid.Row="1" Series="{Binding FluxoCaixaSeries}" LegendLocation="Bottom" Hoverable="True">
                            <lvc:CartesianChart.DataTooltip>
                                <lvc:DefaultTooltip BulletSize="15" CornerRadius="4"/>
                            </lvc:CartesianChart.DataTooltip>
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Title="Mês" Labels="{Binding FluxoCaixaLabels}"/>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis Title="Valor (R$)" LabelFormatter="{Binding FormatterY}"/>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ChartCardStyle}" Grid.Column="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Receita por Local de Pagamento" Style="{StaticResource ChartTitleStyle}"/>

                        <lvc:PieChart Grid.Row="1" Series="{Binding ReceitaLocalSeries}" LegendLocation="Bottom" Hoverable="True" DataClickCommand="{Binding ChartDataClickCommand}">
                            <lvc:PieChart.DataTooltip>
                                <lvc:DefaultTooltip SelectionMode="OnlySender">
                                    <lvc:DefaultTooltip.Content>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Point.SeriesView.Title}" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Point.Y, StringFormat=C, ConverterCulture=pt-BR}" />
                                            <TextBlock Text="{Binding Point.Participation, StringFormat=P}" />
                                        </StackPanel>
                                    </lvc:DefaultTooltip.Content>
                                </lvc:DefaultTooltip>
                            </lvc:PieChart.DataTooltip>
                        </lvc:PieChart>

                    </Grid>
                </Border>
            </Grid>
        </DockPanel>

        <Border Background="#80FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Carregando Dados..." FontSize="18" FontWeight="SemiBold"/>
                <ProgressBar IsIndeterminate="True" Width="250" Height="25" Margin="20"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>